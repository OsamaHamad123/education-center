# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Application DB role (school_app) — NOBYPASSRLS. Used by the running app.
DATABASE_URL="postgresql://school_app:CHANGE_ME@localhost:5432/school"

# Owner DB role (school_owner) — runs drizzle-kit migrations and the seed.
DATABASE_OWNER_URL="postgresql://school_owner:CHANGE_ME@localhost:5432/school"

# Separate database used by the integration test suite.
DATABASE_TEST_URL="postgresql://school_app:CHANGE_ME@localhost:5432/school_test"
DATABASE_TEST_OWNER_URL="postgresql://school_owner:CHANGE_ME@localhost:5432/school_test"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME"
BETTER_AUTH_URL="http://localhost:3000"

# Salt used to hash visitor IPs in lookup_attempts (public lookup rate limiting).
LOOKUP_IP_SALT="CHANGE_ME"

NODE_ENV="development"
TZ="Africa/Cairo"

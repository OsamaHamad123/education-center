# ---------------------------------------------------------------------------
# Copy to .env and fill in the secrets. NEVER commit .env.
# The database values below match the defaults in docker-compose.yml, so
# `pnpm db:up` then `pnpm db:migrate` works without editing them locally.
# ---------------------------------------------------------------------------

# Application DB role (school_app) — NOBYPASSRLS. Used by the running app.
DATABASE_URL="postgresql://school_app:app@localhost:5432/school"

# Owner DB role (school_owner) — runs drizzle-kit migrations and the seed.
DATABASE_OWNER_URL="postgresql://school_owner:owner@localhost:5432/school"

# Separate database used by the integration test suite.
DATABASE_TEST_URL="postgresql://school_app:app@localhost:5432/school_test"
DATABASE_TEST_OWNER_URL="postgresql://school_owner:owner@localhost:5432/school_test"

# Passwords handed to the Postgres container on first start.
POSTGRES_PASSWORD="postgres"
DB_OWNER_PASSWORD="owner"
DB_APP_PASSWORD="app"
DB_PORT="5432"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG"
BETTER_AUTH_URL="http://localhost:3000"

# Salt used to hash visitor IPs in lookup_attempts (public lookup rate limiting).
LOOKUP_IP_SALT="CHANGE_ME_AT_LEAST_16_CHARS"
# Salts the parent phone in portal_sessions and the portal SQL functions.
PORTAL_PHONE_SALT="CHANGE_ME_AT_LEAST_16_CHARS"

NODE_ENV="development"
TZ="Africa/Cairo"
